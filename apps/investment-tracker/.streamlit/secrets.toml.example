# Streamlit Secrets設定ファイル
#
# このファイルをコピーして .streamlit/secrets.toml を作成してください
# secrets.toml は .gitignore に含まれているため、コミットされません
#
# 作成方法:
# 1. このファイルをコピー: cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# 2. 下記の値を実際の値に置き換える

# ========================================
# 必須設定
# ========================================

# J-Quants API V2 APIキー
JQUANTS_API_KEY = "your_api_key_here"

# アプリログイン用パスワード
APP_PASSWORD = "your_secure_password_here"

# ========================================
# Google Sheets設定（シンプル版）
# ========================================
# 詳細: SIMPLE_GSHEETS_SETUP.md を参照

# Google Sheetsを使用するかどうか
# ローカル開発: false（JSONファイル使用）
# Streamlit Cloud: true（Google Sheets使用）
USE_GSHEETS = false

# スプレッドシート読み込み用URL（CSV公開URL）
# 例: https://docs.google.com/spreadsheets/d/e/2PACX-1vS.../pub?gid=0&single=true&output=csv
SPREADSHEET_READ_URL = "your_csv_export_url_here"

# スプレッドシート書き込み用URL（Google Apps Script ウェブアプリURL）
# 例: https://script.google.com/macros/s/AKfycby.../exec
SPREADSHEET_WRITE_URL = "your_apps_script_url_here"
