# ========================================
# 環境変数設定テンプレート
# ========================================
# 【Windows ホスト環境】: システム環境変数で設定（推奨）
# 【コンテナ環境】: このファイルを .env にコピーして値を入力

# ========================================
# J-Quants API 認証
# ========================================
# V2 API Key方式（推奨）
# 取得方法: https://jpx-jquants.com/ でアカウント登録後、APIキーを発行
JQUANTS_API_KEY=

# レガシー: メールアドレス/パスワード方式（非推奨）
# JQUANTS_MAIL_ADDRESS=your-email@example.com
# JQUANTS_PASSWORD=your-password-here

# ========================================
# オプション: Anthropic API (Claude)
# ========================================
# ANTHROPIC_API_KEY=sk-ant-xxx

# ========================================
# タイムゾーン設定
# ========================================
TZ=Asia/Tokyo

# ========================================
# Windows環境変数の設定方法（ホスト環境）
# ========================================
# 1. コマンドプロンプトで設定（一時的）:
#    set JQUANTS_API_KEY=your_actual_api_key_here
#
# 2. システム環境変数で設定（永続的、推奨）:
#    - Windowsキー押下 → "環境変数" で検索
#    - "システム環境変数の編集" を選択
#    - "環境変数" ボタンをクリック
#    - "新規" で JQUANTS_API_KEY を追加
#    - 値に実際のAPIキーを貼り付け
#    - OK で閉じる
#    - コマンドプロンプトを再起動
#
# 3. 確認方法:
#    echo %JQUANTS_API_KEY%

# ========================================
# コンテナ環境での設定方法
# ========================================
# 1. このファイルを .env にコピー:
#    cp .env.example .env
#
# 2. .env を編集して実際の認証情報を入力:
#    JQUANTS_API_KEY=your_actual_api_key_here
#
# 3. コンテナ起動時に自動で読み込まれます:
#    bash scripts/run_secure.sh network
#    # または
#    docker compose run --rm analysis-network

# ========================================
# セキュリティ注意事項（重要）
# ========================================
# ✅ DO:
#   - .env.example はテンプレートとしてコミットOK（値は空）
#   - .env は .gitignore で除外済み（絶対にコミットしない）
#   - スクリプト内では os.environ から読み取る
#
# ❌ DON'T:
#   - .env ファイルを Git にコミット（認証情報漏洩のリスク）
#   - ログやレポートにAPIキーを出力
#   - コード内にAPIキーをハードコード
